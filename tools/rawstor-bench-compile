#!/usr/bin/env python3

import argparse
import datetime
import json
from pathlib import Path
import shutil


# Maximum detail pages and summary rows per test name.
REPO_TABLE_COMMIT_LIMIT = 10


def get_commit_txt(repo_name, commit_sha):
    commit_url = \
        f"https://github.com/rawstor/{repo_name}/commit/" \
        f"{commit_sha}"
    return f"[{commit_sha[:7]}]({commit_url})"


def get_date_txt(dt):
    return dt.strftime("%Y-%m-%d %H:%M:%S")


def read_fio_txt(meta_path, meta):
    filename = meta_path.parent / meta["data"]["txt"]
    with open(filename) as f:
        return f.read()


def read_fio_json(meta_path, meta):
    filename = meta_path.parent / meta["data"]["json"]
    with open(filename) as f:
        return json.load(f)


def load_meta(meta_path):
    with open(meta_path, 'r') as f:
        meta = json.load(f)
        if not isinstance(meta, dict):
            raise ValueError(f"metadata must be an object in {meta_path}")
        for field in ('repo', 'name'):
            if not isinstance(meta.get(field), str) or not meta[field]:
                raise ValueError(f"missing/invalid '{field}' in {meta_path}")
        commit = meta.get("commit")
        if not isinstance(commit, str) or not commit.strip() or any(c in commit for c in "/\\\0"):
            meta["commit"] = meta_path.stem
        date_raw = meta.get("date")
        if not date_raw:
            raise ValueError(f"missing 'date' in {meta_path}")
        data_block = meta.get("data") or {}
        if not isinstance(data_block, dict) or any(
            not isinstance(data_block.get(field), str) or not data_block[field]
            for field in ('txt', 'json')
        ):
            raise ValueError(f"missing/invalid 'data.txt' or 'data.json' in {meta_path}")
        if not isinstance(date_raw, str):
            raise ValueError(f"invalid 'date' in {meta_path}")
        parsed = datetime.datetime.fromisoformat(date_raw.replace('Z', '+00:00'))
        # Match data-processor: dates without an offset are interpreted as UTC.
        if parsed.tzinfo is not None:
            parsed = parsed.astimezone(datetime.timezone.utc).replace(tzinfo=None)
        meta["date"] = parsed
    return meta


def find_job(fio, job_name):
    jobs = fio.get("jobs") or []
    for job in jobs:
        opts = job.get("job options") or {}
        if opts.get("name") == job_name:
            return job
    return None


def _job_options(fio):
    """Return first job's options dict, or empty dict if missing."""
    jobs = fio.get("jobs") or []
    if not jobs:
        return {}
    return jobs[0].get("job options") or {}


def compile_commit_md(
    dest_abspath, dest_path, repo_name, meta_path, meta, fio, name,
):
    fio_txt = read_fio_txt(meta_path, meta)

    dest_abspath.mkdir(parents=True, exist_ok=True)

    commit_sha = meta["commit"]

    url = f"{dest_path}/{commit_sha}.md"
    filename = dest_abspath / f"{commit_sha}.md"
    job = _job_options(fio)
    with open(filename, "w") as commit_md:
        commit_md.write("[&lt; back](..)\n\n")
        commit_md.write(f"# {name}\n\n")
        commit_md.write(f"{get_date_txt(meta['date'])}\n\n")
        commit_md.write(f"{meta['branch']}\n\n")
        commit_md.write(f"{get_commit_txt(repo_name, commit_sha)}\n\n")
        commit_md.write(f"rw = {job.get('rw', '?')}, ")
        commit_md.write(f"bs = {job.get('bs', '?')}, ")
        commit_md.write(f"iodepth = {job.get('iodepth', '?')}, ")
        commit_md.write(f"numjobs = {job.get('numjobs', '?')}\n\n")
        commit_md.write("```\n")
        commit_md.write(fio_txt)
        commit_md.write("```\n")

    return url


def _fmt_metric(value):
    """Format a numeric metric, '-' for None."""
    if value is None:
        return "-"
    try:
        return f"{float(value):.2f}"
    except (TypeError, ValueError):
        return "-"


def _job_section(job, direction):
    """Return read/write section dict, or None."""
    section = job.get(direction) if job else None
    return section if isinstance(section, dict) else None


def _job_iops(job, direction):
    section = _job_section(job, direction)
    return section.get('iops') if section else None


def _job_lat_mean(job, direction):
    """Latency mean in ms (matches data-processor convention)."""
    section = _job_section(job, direction)
    if not section:
        return None
    lat_ns = section.get('lat_ns')
    if isinstance(lat_ns, dict):
        mean = lat_ns.get('mean')
        if mean is None:
            return None
        return float(mean) / 1_000_000
    return None


def compile_repo_md(dest_abspath, dest_path, repo_name, repo):
    dest_abspath.mkdir(parents=True, exist_ok=True)

    url = f"{dest_path}/README.md"
    filename = dest_abspath / "README.md"
    with open(filename, "w") as repo_md:
        repo_md.write(f"# [&lt;](..) {repo_name} tests\n\n")
        for name, metas in repo:
            fios = []
            for meta_path, meta in metas:
                try:
                    fio = read_fio_json(meta_path, meta)
                    commit_md_url = compile_commit_md(
                        dest_abspath / name, name, repo_name,
                        meta_path, meta, fio, name,
                    )
                    fios.append((meta_path, meta, fio, commit_md_url))
                    if len(fios) == REPO_TABLE_COMMIT_LIMIT:
                        break
                except (OSError, json.JSONDecodeError, KeyError) as e:
                    print(f"  Skipping {meta_path}: {e}")
                    continue

            job_names = set()
            for meta_path, meta, fio, commit_md_url in fios:
                for job in fio.get("jobs", []):
                    opts = job.get("job options") or {}
                    if opts.get("name"):
                        job_names.add(opts["name"])
            job_names = sorted(job_names)

            repo_md.write(f"## {name}\n\n")

            repo_md.write(
                "| "
                "Date | "
                "Branch | "
                "Commit | "
            )
            for job_name in job_names:
                repo_md.write(
                    f"{job_name}<br>Read IOPS | "
                    f"{job_name}<br>Read Latency | "
                    f"{job_name}<br>Write IOPS | "
                    f"{job_name}<br>Write Latency |"
                )
            repo_md.write("\n")

            repo_md.write(
                "| "
                ":--- | "
                ":---   | "
                ":---   | "
            )
            for job_name in job_names:
                repo_md.write(
                    "     ---: | "
                    "        ---: | "
                    "      ---: | "
                    "         ---: |"
                )
            repo_md.write("\n")

            for meta_path, meta, fio, commit_md_url in fios:
                commit_sha = meta["commit"]

                repo_md.write(
                    f"| "
                    f"[{get_date_txt(meta['date'])}]({commit_md_url}) | "
                    f"{meta['branch']} | "
                    f"{get_commit_txt(repo_name, commit_sha)} | "
                )
                for job_name in job_names:
                    job = find_job(fio, job_name)
                    if job is None:
                        repo_md.write(" |  |  |  |")
                    else:
                        repo_md.write(
                            f"{_fmt_metric(_job_iops(job, 'read'))} | "
                            f"{_fmt_metric(_job_lat_mean(job, 'read'))} | "
                            f"{_fmt_metric(_job_iops(job, 'write'))} | "
                            f"{_fmt_metric(_job_lat_mean(job, 'write'))} |"
                        )
                repo_md.write("\n")
            repo_md.write("\n")

    return url


def compile_index_md(dest_abspath, repos):
    dest_abspath.mkdir(parents=True, exist_ok=True)
    with open(dest_abspath / "README.md", "w") as index_md:
        index_md.write("[&lt; back](..)\n\n")
        for repo_name, repo in repos:
            repo = sorted(list(repo.items()))
            repo_md_dest_path = f"{repo_name}"
            repo_md_dest_abspath = dest_abspath / repo_md_dest_path
            repo_md_url = compile_repo_md(
                repo_md_dest_abspath,
                repo_md_dest_path,
                repo_name,
                repo,
            )
            index_md.write(f"[{repo_name} tests]({repo_md_url})\n")


def compile_fio(prefix=None, **kwargs):
    prefix = Path(prefix)
    src_dir = prefix / "data" / "fio"

    metas = []
    for meta_path in src_dir.glob("**/*.meta"):
        try:
            metas.append((meta_path, load_meta(meta_path)))
        except (OSError, json.JSONDecodeError, ValueError, KeyError) as e:
            print(f"  Skipping {meta_path}: {e}")
            continue

    metas.sort(key=lambda meta: meta[1]["date"], reverse=True)

    repos = {}
    for meta_path, meta in metas:
        repo = repos.setdefault(meta["repo"], {})
        repo.setdefault(meta["name"], []).append((meta_path, meta))
    repos = sorted(list(repos.items()))

    dest_abspath = Path(prefix) / "docs" / "fio"
    shutil.rmtree(dest_abspath, ignore_errors=True)
    compile_index_md(dest_abspath, repos)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--prefix", help="prefix", required=True)
    parser.add_argument("what", help="what to compile", choices=("fio",))
    args = parser.parse_args()

    if args.what == "fio":
        compile_fio(**vars(args))

    print("Compiled successfully")


if __name__ == '__main__':
    main()
