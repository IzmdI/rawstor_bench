#!/usr/bin/env python3

"""Generate dashboard data.json from raw fio benchmark results.

Reads per-test JSON + .meta sidecar files, extracts IOPS/latency metrics,
groups by config and branch, downsamples to 1 point/day/group, and writes
a single data.json for the frontend dashboard.

Usage:
    python3 tools/data-processor [DAYS]

DAYS=0 means include all available data.
"""

import json
import re
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional

METRICS = ['iops_read', 'iops_write', 'latency_read', 'latency_write']
MAX_BRANCHES = 32
TIMESTAMP_FORMATS = [
    '%Y-%m-%dT%H:%M:%S.%f',
    '%Y-%m-%dT%H:%M:%S',
    '%Y-%m-%d %H:%M:%S',
    '%Y-%m-%d',
]


def main() -> None:
    days = _parse_days_arg()
    script_dir = Path(__file__).parent
    repo_root = script_dir.parent
    data_path = repo_root / 'data' / 'fio' / 'librawstor'
    output_path = repo_root / 'docs' / 'fio' / 'librawstor' / 'dashboard' / 'data.json'

    if not data_path.exists():
        print(f"Data path does not exist: {data_path}")
        sys.exit(1)

    cutoff_date = datetime.now(tz=timezone.utc).replace(tzinfo=None) - timedelta(days=days)
    output_path.parent.mkdir(parents=True, exist_ok=True)

    results = collect_raw_data(data_path, cutoff_date)
    if not results:
        print(f"No results for last {days} days, falling back to all data")
        results = collect_raw_data(data_path)
        days = 0

    top_branches = _get_top_branches(results, MAX_BRANCHES)
    charts = prepare_charts_data(results, top_branches)
    summary = build_summary(results, charts, cutoff_date, top_branches)

    output = {
        'generated_at': datetime.now(tz=timezone.utc).isoformat(),
        'filter': {
            'days': days,
            'cutoff_date': cutoff_date.isoformat() + 'Z',
            'applied': days > 0 and len(results) > 0,
        },
        'charts': charts,
        'summary': summary,
    }

    with output_path.open('w', encoding='utf-8') as f:
        json.dump(output, f, indent=2, ensure_ascii=False)

    size_mb = output_path.stat().st_size / (1024 * 1024)
    branch_info = ''
    if top_branches:
        branch_info = f', {len(top_branches)} of {summary["total_branches_all"]} branches'
    print(f"data.json: {len(results)} tests, {size_mb:.1f} MB, {days or 'all'} days{branch_info}")


def _parse_days_arg() -> int:
    if len(sys.argv) > 1:
        try:
            return int(sys.argv[1])
        except ValueError:
            print(f"Invalid argument: {sys.argv[1]}, using default 365")
    return 365


def parse_timestamp(raw: str) -> Optional[datetime]:
    """Parse a timestamp string, stripping timezone info."""
    if not raw:
        return None

    s = raw.strip()

    # Strip timezone suffix: +HH:MM, -HH:MM, +HHMM, -HHMM, or Z
    if s.endswith('Z'):
        s = s[:-1]
    s = re.sub(r'[+-]\d{2}:?\d{2}$', '', s)

    for fmt in TIMESTAMP_FORMATS:
        try:
            return datetime.strptime(s, fmt)
        except ValueError:
            continue
    return None


def collect_raw_data(
    data_path: Path,
    cutoff_date: Optional[datetime] = None,
) -> List[Dict[str, Any]]:
    """Collect test results from all config directories, optionally filtered by date."""
    results: List[Dict[str, Any]] = []

    for config_dir in sorted(data_path.iterdir()):
        if not config_dir.is_dir():
            continue

        for json_file in config_dir.rglob('*.json'):
            try:
                result = _process_test_file(config_dir.name, json_file, cutoff_date)
                if result:
                    results.append(result)
            except Exception as e:
                print(f"  Error processing {json_file.name}: {e}")

    return results


def _process_test_file(
    config_name: str,
    json_file: Path,
    cutoff_date: Optional[datetime],
) -> Optional[Dict[str, Any]]:
    commit_sha = json_file.stem
    meta_file = json_file.with_suffix('.meta')

    test_data = json.loads(json_file.read_text(encoding='utf-8'))
    meta_data = {}
    if meta_file.exists():
        meta_data = json.loads(meta_file.read_text(encoding='utf-8'))

    timestamp = parse_timestamp(meta_data.get('date', ''))
    if cutoff_date and not _is_recent(timestamp, cutoff_date):
        return None

    metrics = extract_fio_metrics(test_data)
    if not metrics:
        return None

    ts_str = timestamp.isoformat() + 'Z' if timestamp else 'Unknown date'

    return {
        'config': config_name,
        'commit_sha': commit_sha,
        'timestamp': ts_str,
        'timestamp_obj': timestamp,
        'branch': meta_data.get('branch', 'unknown'),
        'test_url': f'../{config_name}/{commit_sha}.md',
        **metrics,
    }


def _is_recent(timestamp: Optional[datetime], cutoff_date: datetime) -> bool:
    return timestamp is None or timestamp >= cutoff_date


def extract_fio_metrics(test_data: Dict[str, Any]) -> Dict[str, float]:
    """Extract IOPS and latency metrics from fio JSON output."""
    metrics: Dict[str, float] = {}

    jobs = test_data.get('jobs', [])
    if not jobs:
        return metrics

    job = jobs[0]

    for direction in ('read', 'write'):
        section = job.get(direction, {})
        if not isinstance(section, dict):
            continue

        # IOPS
        iops = section.get('iops')
        if iops is not None:
            metrics[f'iops_{direction}'] = float(iops)

        # Latency (preferred: lat_ns.mean in nanoseconds)
        lat_ns = section.get('lat_ns', {})
        if isinstance(lat_ns, dict) and 'mean' in lat_ns:
            metrics[f'latency_{direction}'] = float(lat_ns['mean']) / 1_000_000
        else:
            # Fallback: lat.mean in microseconds
            lat = section.get('lat', {})
            if isinstance(lat, dict) and 'mean' in lat:
                metrics[f'latency_{direction}'] = float(lat['mean']) / 1000

    return metrics


def prepare_charts_data(results: List[Dict[str, Any]], top_branches: Optional[List[str]] = None) -> Dict[str, List[Dict]]:
    """Build chart arrays grouped by config and branch with daily downsampling."""
    dated = [r for r in results if r.get('timestamp_obj')]
    undated = [r for r in results if not r.get('timestamp_obj')]
    dated.sort(key=lambda r: r['timestamp_obj'])

    charts: Dict[str, List[Dict]] = {}
    for metric in METRICS:
        charts[f'{metric}_by_config'] = _group_by(dated + undated, metric, 'config')
        charts[f'{metric}_by_branch'] = _group_by(dated + undated, metric, 'branch', top_branches)
    return charts


def _get_top_branches(results: List[Dict[str, Any]], limit: int) -> Optional[List[str]]:
    """Get the most recently updated branches, limited to `limit`."""
    latest_by_branch: Dict[str, datetime] = {}
    for r in results:
        branch = r['branch']
        ts = r.get('timestamp_obj')
        if ts and (branch not in latest_by_branch or ts > latest_by_branch[branch]):
            latest_by_branch[branch] = ts

    sorted_branches = sorted(latest_by_branch.keys(), key=lambda b: latest_by_branch[b], reverse=True)
    if len(sorted_branches) <= limit:
        return None
    return sorted_branches[:limit]


def _group_by(
    results: List[Dict[str, Any]],
    metric: str,
    key_field: str,
    allowed_keys: Optional[List[str]] = None,
) -> List[Dict]:
    """Group results by a field, extract chart points, and downsample daily."""
    allowed_set = set(allowed_keys) if allowed_keys else None
    op = 'read' if metric.endswith('_read') else 'write'
    groups: Dict[str, List[Dict]] = {}
    for r in results:
        if metric not in r or r[metric] is None:
            continue
        key = r[key_field]
        if allowed_set and key not in allowed_set:
            continue
        groups.setdefault(key, []).append({
            'group': key,
            'timestamp': r['timestamp'],
            'value': r[metric],
            'commit_sha': r['commit_sha'],
            'branch': r['branch'],
            'config': r['config'],
            'test_url': r['test_url'],
            'operation': op,
        })

    chart_data: List[Dict] = []
    for points in groups.values():
        chart_data.extend(downsample_daily(points))
    return chart_data


def downsample_daily(points: List[Dict]) -> List[Dict]:
    """Keep at most 1 point per day per group (the latest one)."""
    if not points:
        return points

    daily: Dict[str, Dict] = {}
    for p in points:
        ts = p['timestamp']
        day_key = 'Unknown date' if ts == 'Unknown date' else ts[:10]
        if day_key not in daily or ts > daily[day_key]['timestamp']:
            daily[day_key] = p

    return sorted(
        daily.values(),
        key=lambda x: x['timestamp'] if x['timestamp'] != 'Unknown date' else '9999-12-31',
    )


def build_summary(
    results: List[Dict[str, Any]],
    charts: Dict[str, List[Dict]],
    cutoff_date: datetime,
    top_branches: Optional[List[str]] = None,
) -> Dict[str, Any]:
    """Build summary metadata for the dashboard."""
    configs = sorted({r['config'] for r in results})
    all_branches = sorted({r['branch'] for r in results})

    if top_branches is not None:
        branches = sorted(set(all_branches) & set(top_branches))
    else:
        branches = all_branches

    timestamps = [r['timestamp_obj'] for r in results if r.get('timestamp_obj')]
    time_range = {
        'start': min(timestamps).isoformat() + 'Z' if timestamps else None,
        'end': max(timestamps).isoformat() + 'Z' if timestamps else None,
    }

    return {
        'total_tests': len(results),
        'tests_without_date': sum(1 for r in results if not r.get('timestamp_obj')),
        'total_configurations': len(configs),
        'total_branches_all': len(all_branches),
        'total_branches': len(branches),
        'configurations': configs,
        'branches': branches,
        'time_range': time_range,
    }


if __name__ == '__main__':
    main()
